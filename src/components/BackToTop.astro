---
import Icon from './Icon.astro';
---

<a
  href="#inicio"
  data-to-top
  data-visible="false"
  aria-label="Voltar ao topo"
  class="to-top fixed bottom-[max(5.25rem,calc(env(safe-area-inset-bottom)+4.25rem))] right-5 z-40 grid h-11 w-11 place-items-center rounded-full border border-white/25 bg-ink/90 text-white"
>
  <Icon name="arrowUp" class="h-5 w-5" />
</a>
