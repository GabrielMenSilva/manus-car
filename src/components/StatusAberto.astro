---
// Indicador "Aberto agora / Fechado". Sem JS mostra o horário fixo; o motion.ts calcula o estado.
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const h = site.horarios.find((x) => x.abre)!;
---

<p data-open-status data-state="unknown" class:list={['inline-flex items-center gap-2 text-sm font-medium', cls]} aria-live="polite">
  <span class="status-dot" aria-hidden="true"></span>
  <span data-label>{h.rotulo}, {h.texto}</span>
</p>
