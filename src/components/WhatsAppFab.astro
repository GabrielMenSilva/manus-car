---
import Icon from './Icon.astro';
import { linkWhatsapp } from '../data/site';
---

<a
  href={linkWhatsapp()}
  aria-label="Falar com a Manus Car no WhatsApp"
  class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-ink shadow-lg transition-transform duration-200 hover:scale-105 active:scale-95"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>
